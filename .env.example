# CSV-Export-URL des Google Sheets mit den Auftritten (Spalten: Datum, Uhrzeit, Titel, Ort, Beschreibung).
# Sheet freigeben als "Jeder mit dem Link kann ansehen", dann:
# Datei > Freigeben > Im Web veröffentlichen > CSV, oder die gviz/tq-CSV-URL verwenden.
AUFTRITTE_SHEET_CSV_URL=

# CSV-Export-URL des Google Sheets mit den Setlisten (Spalten: Datum, Liedtitel, Liedtext).
# Datum muss zu einem Auftritt-Datum passen. Genauso freigeben wie oben.
SETLISTEN_SHEET_CSV_URL=
