{
	// Static Assets weiterhin über `astro build` (./dist). Zusätzlich ein
	// schlanker eigener Worker (src/worker.ts) für die Live-Auftritte-Route —
	// kein Astro-Cloudflare-SSR-Adapter, deshalb tritt das Adapter-Doppel-
	// Build-Problem aus docs/adr/0001-content-pipeline.md hier nicht auf.
	"name": "emscherspatzen",
	"compatibility_date": "2026-09-20",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Nicht geheim: dieselbe "Jeder mit Link"-Sheet-URL, die schon als
	// Build-Variable existiert und deren Inhalt ohnehin öffentlich über
	// /api/auftritte ausgeliefert wird. Muss hier stehen, nicht nur im
	// Dashboard, weil `npx wrangler deploy` im CI-Build aus dieser Datei
	// liest und eine nur im Dashboard gesetzte Runtime-Variable beim
	// nächsten Git-Deploy sonst verwirft.
	"vars": {
		"AUFTRITTE_SHEET_CSV_URL": "https://docs.google.com/spreadsheets/d/1hANtmFERY5xL_EUv-EV599iO7ic3bcSswo5c_HtkGZI/export?format=csv&gid=0"
	}
}
