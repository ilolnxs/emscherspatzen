---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<title>{title} · Emscherspatzen</title>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand">
				<picture>
					<source media="(prefers-reduced-motion: reduce)" srcset="/logo/emscherspatzen.svg" />
					<img src="/logo/emscherspatzen-animiert.gif" alt="Emscherspatzen" class="logo" />
				</picture>
			</a>
			<nav class="site-nav">
				<a href="/">Start</a>
				<a href="/bewerber">Mitmachen</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<picture>
				<source media="(prefers-reduced-motion: reduce)" srcset="/logo/emscherspatzen-weiss.svg" />
				<img src="/logo/emscherspatzen-animiert-weiss.gif" alt="" class="footer-logo" />
			</picture>
			<p>&copy; {new Date().getFullYear()} Emscherspatzen</p>
			<nav class="footer-links">
				<a href="https://www.instagram.com/emscherspatzen/" target="_blank" rel="noopener">Instagram</a>
				<a href="https://www.facebook.com/p/Emscherspatzen-61559962716887/" target="_blank" rel="noopener">Facebook</a>
			</nav>
		</footer>
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.site-header {
		padding: 0.6rem clamp(1rem, 5vw, 3rem);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		display: inline-flex;
	}

	.logo {
		height: clamp(2rem, 4vw, 2.5rem);
		width: auto;
	}

	.site-nav {
		display: flex;
		gap: clamp(1.25rem, 3vw, 2rem);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
	}

	.site-nav a {
		color: var(--blau-dunkel);
		text-decoration: none;
		padding-block-end: 0.15rem;
		border-bottom: 2px solid transparent;
	}

	.site-nav a:hover {
		border-color: var(--blau);
	}

	main {
		flex: 1;
	}

	.site-footer {
		margin-block-start: 4rem;
		padding: 2.5rem clamp(1rem, 5vw, 3rem);
		background: var(--blau-dunkel);
		color: var(--blau-hell);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	.footer-links {
		margin-inline-start: auto;
		display: flex;
		gap: 1.25rem;
		font-size: 0.9rem;
	}

	.footer-links a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}

	.footer-links a:hover {
		border-color: currentColor;
	}

	.footer-logo {
		height: 2.5rem;
		width: auto;
	}

	.site-footer p {
		margin: 0;
		font-size: 0.9rem;
	}
</style>
