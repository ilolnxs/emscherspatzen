---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Start">
	<section class="hero">
		<picture>
			<source media="(prefers-reduced-motion: reduce)" srcset="/logo/emscherspatzen-weiss.svg" />
			<img src="/logo/emscherspatzen-animiert-weiss.gif" alt="Emscherspatzen" class="hero-logo" />
		</picture>
		<p class="tagline">
			„Andere Städte haben auch einen Chor, aber so wie wir singt dir keiner was vor.“
		</p>
	</section>

	<div class="inhalt">
		<section>
			<h2>Bevorstehende Auftritte</h2>
			<div id="bevorstehende-liste"><p>Aktuell sind keine Auftritte geplant.</p></div>
		</section>

		<section>
			<h2>Vergangene Auftritte</h2>
			<div id="vergangene-liste"><p>Noch keine vergangenen Auftritte.</p></div>
		</section>
	</div>

	<section class="hoer-rein" slot="abschluss">
		<div class="hoer-rein-inhalt">
			<h2>Hör rein</h2>
			<iframe
				src="https://open.spotify.com/embed/artist/22At3yJ4NbkH4fBnh5EHvi?utm_source=generator"
				title="Emscherspatzen auf Spotify"
				width="100%"
				height="152"
				frameborder="0"
				allowfullscreen
				allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				loading="lazy"></iframe>
		</div>
	</section>
</BaseLayout>

<script>
	(function () {
		'use strict';
		var DATUM_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
		var MONATE = ['JAN', 'FEB', 'MÄR', 'APR', 'MAI', 'JUN', 'JUL', 'AUG', 'SEP', 'OKT', 'NOV', 'DEZ'];

		interface AuftrittRow {
			datum: string;
			titel: string;
			ort: string;
			uhrzeit: string;
			beschreibung: string;
		}

		function escapeHtml(s: unknown): string {
			var ESCAPES: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
			return String(s).replace(/[&<>"']/g, function (c) {
				return ESCAPES[c];
			});
		}

		// Quote-aware CSV-Split: ein Komma innerhalb von "..." (z.B. im Ort-Feld) darf
		// die Spalten nicht verschieben.
		function splitCsvLine(line: string): string[] {
			var out = [],
				field = '',
				inQuotes = false;
			for (var i = 0; i < line.length; i++) {
				var c = line[i];
				if (inQuotes) {
					if (c === '"') {
						if (line[i + 1] === '"') {
							field += '"';
							i++;
						} else {
							inQuotes = false;
						}
					} else {
						field += c;
					}
				} else {
					if (c === '"') inQuotes = true;
					else if (c === ',') {
						out.push(field);
						field = '';
					} else field += c;
				}
			}
			out.push(field);
			return out;
		}

		function parseAuftritte(csv: string): AuftrittRow[] {
			var lines = csv.split(/\r\n|\n/).filter(function (l) {
				return l.trim() !== '';
			});
			if (!lines.length) return [];
			var header = splitCsvLine(lines[0]).map(function (h) {
				return h.trim().toLowerCase();
			});
			var idx = {
				datum: header.indexOf('datum'),
				titel: header.indexOf('titel'),
				ort: header.indexOf('ort'),
				uhrzeit: header.indexOf('uhrzeit'),
				beschreibung: header.indexOf('beschreibung'),
			};
			var out: AuftrittRow[] = [];
			for (var i = 1; i < lines.length; i++) {
				var f = splitCsvLine(lines[i]);
				var datum = (f[idx.datum] || '').trim();
				var titel = (f[idx.titel] || '').trim();
				if (!DATUM_PATTERN.test(datum) || !titel) continue; // ungültige/leere Zeile überspringen, nicht abbrechen
				out.push({
					datum: datum,
					titel: titel,
					ort: idx.ort > -1 ? (f[idx.ort] || '').trim() : '',
					uhrzeit: idx.uhrzeit > -1 ? (f[idx.uhrzeit] || '').trim() : '',
					beschreibung: idx.beschreibung > -1 ? (f[idx.beschreibung] || '').trim() : '',
				});
			}
			return out;
		}

		function splitByZeitpunkt(auftritte: AuftrittRow[]): { bevorstehende: AuftrittRow[]; vergangene: AuftrittRow[] } {
			var heuteIso = new Date().toISOString().slice(0, 10);
			return {
				bevorstehende: auftritte
					.filter(function (a) {
						return a.datum >= heuteIso;
					})
					.sort(function (a, b) {
						return a.datum.localeCompare(b.datum);
					}),
				vergangene: auftritte
					.filter(function (a) {
						return a.datum < heuteIso;
					})
					.sort(function (a, b) {
						return b.datum.localeCompare(a.datum);
					}),
			};
		}

		function auftrittHtml(a: AuftrittRow, zeigeBeschreibung: boolean): string {
			var p = a.datum.split('-');
			var metaTeile: string[] = [];
			if (a.uhrzeit) metaTeile.push(escapeHtml(a.uhrzeit) + ' Uhr');
			if (a.ort) metaTeile.push(escapeHtml(a.ort));
			return (
				'<li>' +
				'<div class="datumsschild">' +
				'<span class="tag">' +
				p[2] +
				'</span>' +
				'<span class="monat">' +
				MONATE[parseInt(p[1], 10) - 1] +
				'</span>' +
				'<span class="jahr">' +
				p[0] +
				'</span>' +
				'</div>' +
				'<div class="auftritt-info"><h3>' +
				escapeHtml(a.titel) +
				'</h3>' +
				(metaTeile.length ? '<p class="meta">' + metaTeile.join(' · ') + '</p>' : '') +
				(zeigeBeschreibung && a.beschreibung ? '<p class="beschreibung">' + escapeHtml(a.beschreibung) + '</p>' : '') +
				'</div></li>'
			);
		}

		function renderListe(
			el: HTMLElement,
			auftritte: AuftrittRow[],
			klasse: string,
			zeigeBeschreibung: boolean,
			leerText: string
		): void {
			if (!auftritte.length) {
				el.innerHTML = '<p>' + leerText + '</p>';
				return;
			}
			el.innerHTML =
				'<ul class="auftritte-liste' +
				(klasse ? ' ' + klasse : '') +
				'">' +
				auftritte
					.map(function (a) {
						return auftrittHtml(a, zeigeBeschreibung);
					})
					.join('') +
				'</ul>';
		}

		function ladeAuftritte(): void {
			const bevorstehendeEl = document.getElementById('bevorstehende-liste');
			const vergangeneEl = document.getElementById('vergangene-liste');
			if (!bevorstehendeEl || !vergangeneEl) return;
			fetch('/api/auftritte')
				.then(function (res) {
					if (!res.ok) throw new Error('HTTP ' + res.status);
					return res.text();
				})
				.then(function (csv) {
					var split = splitByZeitpunkt(parseAuftritte(csv));
					renderListe(bevorstehendeEl, split.bevorstehende, '', true, 'Aktuell sind keine Auftritte geplant.');
					renderListe(vergangeneEl, split.vergangene, 'vergangen', false, 'Noch keine vergangenen Auftritte.');
				})
				.catch(function (err) {
					console.warn('Auftritte konnten nicht geladen werden:', err);
				});
		}

		ladeAuftritte();
	})();
</script>

<style>
	.hero {
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2.5rem, 8vw, 5rem) clamp(1rem, 5vw, 3rem);
		text-align: center;
	}

	.hero-logo {
		width: min(280px, 70vw);
		height: auto;
	}

	.tagline {
		max-width: 34ch;
		margin: 1.5rem auto 0;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2vw + 0.5rem, 1.4rem);
		font-weight: 500;
		line-height: 1.4;
	}

	.inhalt {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 3rem);
	}

	section {
		margin-block-end: 3rem;
	}

	.hoer-rein {
		margin-block-end: 0;
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 5vw, 3rem);
	}

	.hoer-rein-inhalt {
		max-width: 720px;
		margin: 0 auto;
	}

	.hoer-rein h2 {
		margin: 0 0 1rem;
	}

	.hoer-rein iframe {
		display: block;
		border-radius: 12px;
	}
</style>

<!--
	Global statt scoped: dieses Markup entsteht zur Laufzeit per innerHTML
	(siehe <script> oben), nicht beim Astro-Build. Astros Scoped-Styles hängen
	ein data-astro-cid-Attribut an Elemente, das nur beim Build vergeben wird
	– client-injiziertes HTML bekommt es nie und würde von scoped CSS nicht
	getroffen.
-->
<style is:global>
	.auftritte-liste {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.auftritte-liste li {
		display: flex;
		gap: 1.25rem;
		border: 1px solid var(--blau-hell);
		border-inline-start: 4px solid var(--blau);
		padding: 1rem 1.25rem;
		background: var(--weiss);
	}

	.auftritte-liste.vergangen li {
		border-inline-start-color: #b7bfc9;
		background: transparent;
	}

	.datumsschild {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 3.75rem;
		font-family: var(--font-display);
		line-height: 1;
	}

	.datumsschild .tag {
		font-size: 1.75rem;
		font-weight: 800;
		color: var(--blau-dunkel);
	}

	.datumsschild .monat {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--blau);
		margin-block-start: 0.2rem;
	}

	.datumsschild .jahr {
		font-size: 0.65rem;
		color: #6b7280;
		margin-block-start: 0.1rem;
	}

	.vergangen .datumsschild .tag,
	.vergangen .datumsschild .monat,
	.vergangen .datumsschild .jahr {
		color: #6b7280;
	}

	.auftritt-info {
		min-width: 0;
	}

	.auftritt-info h3 {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0;
	}

	.meta {
		margin: 0.2rem 0 0;
		font-size: 0.9375rem;
		color: #4b5563;
	}

	.beschreibung {
		margin: 0.5rem 0 0;
	}
</style>
