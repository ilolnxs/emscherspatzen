---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import titelbild from '../assets/titelbild.jpg';
import Auftritte from '../components/Auftritte.astro';
---

<BaseLayout title="Start">
	<section class="hero">
		<Image
			src={titelbild}
			alt="Die Emscherspatzen in Collegejacken auf der Bühne vor jubelndem Publikum"
			class="hero-bild"
			widths={[640, 960, 1280, 1600]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero-inhalt">
		<picture>
			<source media="(prefers-reduced-motion: reduce)" srcset="/logo/emscherspatzen-weiss.svg" />
			<img src="/logo/emscherspatzen-animiert-weiss.webp" alt="Emscherspatzen" class="hero-logo" />
		</picture>
		<p class="tagline">
			„Andere Städte haben auch einen Chor, aber so wie wir singt dir keiner was vor.“
		</p>
		</div>
	</section>

	<div class="inhalt">
		<Auftritte limit={3} />
		<p><a href="/auftritte">Alle Auftritte ansehen →</a></p>
	</div>

	<section class="hoer-rein" slot="abschluss">
		<div class="hoer-rein-inhalt">
			<h2>Hör rein</h2>
			<iframe
				src="https://open.spotify.com/embed/artist/22At3yJ4NbkH4fBnh5EHvi?utm_source=generator"
				title="Emscherspatzen auf Spotify"
				width="100%"
				height="152"
				frameborder="0"
				allowfullscreen
				allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				loading="lazy"></iframe>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		min-height: min(80vh, 760px);
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2.5rem, 8vw, 5rem) clamp(1rem, 5vw, 3rem);
		text-align: center;
	}

	.hero-bild {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			to bottom,
			rgb(14 38 71 / 0.88),
			rgb(14 38 71 / 0.5) 60%,
			rgb(14 38 71 / 0.4)
		);
	}

	.hero-logo {
		width: min(280px, 70vw);
		height: auto;
		filter: drop-shadow(0 2px 12px rgb(14 38 71 / 0.6));
	}

	.tagline {
		max-width: 34ch;
		margin: 1.5rem auto 0;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2vw + 0.5rem, 1.4rem);
		font-weight: 500;
		line-height: 1.4;
	}

	.inhalt {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 3rem);
	}

	.hoer-rein {
		margin-block-end: 0;
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 5vw, 3rem);
	}

	.hoer-rein-inhalt {
		max-width: 720px;
		margin: 0 auto;
	}

	.hoer-rein h2 {
		margin: 0 0 1rem;
	}

	.hoer-rein iframe {
		display: block;
		border-radius: 12px;
	}
</style>
