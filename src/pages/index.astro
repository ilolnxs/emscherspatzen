---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import titelbild from '../assets/titelbild.jpg';
import Auftritte from '../components/Auftritte.astro';
---

<BaseLayout title="Start">
	<section class="hero">
		<Image
			src={titelbild}
			alt="Die Emscherspatzen in Collegejacken auf der Bühne vor jubelndem Publikum"
			class="hero-bild"
			widths={[640, 960, 1280, 1600]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="ticker" id="ticker" hidden aria-label="Nächste Auftritte">
			<div class="ticker-spur" id="ticker-spur"></div>
		</div>
		<div class="hero-inhalt">
		<picture>
			<source media="(prefers-reduced-motion: reduce)" srcset="/logo/emscherspatzen-weiss.svg" />
			<img src="/logo/emscherspatzen-animiert-weiss.webp" alt="Emscherspatzen" class="hero-logo" />
		</picture>
		<p class="tagline">
			„Andere Städte haben auch einen Chor, aber so wie wir singt dir keiner was vor.“
		</p>
		</div>
	</section>

	<script>
		import { parseAuftritte, splitByZeitpunkt, formatDatumZeit, type Auftritt } from '../lib/auftritte';

		// Konzept: Demo-Daten per ?ticker-demo, solange im Sheet keine kommenden Auftritte stehen.
		const DEMO: Auftritt[] = [
			{ slug: 'a', datum: '2026-11-14', uhrzeit: '19:30', titel: 'Herbstkonzert', ort: 'Herne', beschreibung: '' },
			{ slug: 'b', datum: '2026-12-05', uhrzeit: '18:00', titel: 'Weihnachtsmarkt', ort: 'Gelsenkirchen', beschreibung: '' },
			{ slug: 'c', datum: '2027-01-23', uhrzeit: '20:00', titel: 'Neujahrsempfang', ort: 'Bochum', beschreibung: '' },
		];

		const ticker = document.getElementById('ticker')!;
		const spur = document.getElementById('ticker-spur')!;

		function zeige(auftritte: Auftritt[]) {
			if (!auftritte.length) return;
			const html = auftritte
				.map((a) => `<span class="ticker-eintrag"><b>${formatDatumZeit(a)}</b> ${esc(a.titel)}${a.ort ? ' · ' + esc(a.ort) : ''}</span>`)
				.join('');
			// Zweimal, damit die Endlosschleife (translateX -50%) nahtlos läuft.
			spur.innerHTML = html + html;
			ticker.hidden = false;
		}

		function esc(s: string) {
			return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
		}

		fetch('/api/auftritte')
			.then((r) => (r.ok ? r.text() : ''))
			.catch(() => '')
			.then((csv) => {
				const kommende = splitByZeitpunkt(parseAuftritte(csv)).bevorstehende.slice(0, 3);
				zeige(kommende.length || !location.search.includes('ticker-demo') ? kommende : DEMO);
			});
	</script>

	<div class="inhalt">
		<Auftritte limit={3} />
		<p><a href="/auftritte">Alle Auftritte ansehen →</a></p>
	</div>

	<section class="hoer-rein" slot="abschluss">
		<div class="hoer-rein-inhalt">
			<h2>Hör rein</h2>
			<iframe
				src="https://open.spotify.com/embed/artist/22At3yJ4NbkH4fBnh5EHvi?utm_source=generator"
				title="Emscherspatzen auf Spotify"
				width="100%"
				height="152"
				frameborder="0"
				allowfullscreen
				allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				loading="lazy"></iframe>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		min-height: min(80vh, 760px);
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2.5rem, 8vw, 5rem) clamp(1rem, 5vw, 3rem);
		text-align: center;
	}

	.hero-bild {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			to bottom,
			rgb(14 38 71 / 0.88),
			rgb(14 38 71 / 0.5) 60%,
			rgb(14 38 71 / 0.4)
		);
	}

	.ticker {
		position: absolute;
		inset: 0 0 auto 0;
		overflow: hidden;
		background: rgb(14 38 71 / 0.85);
		border-block-end: 1px solid rgb(255 255 255 / 0.2);
		font-family: var(--font-display);
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.ticker-spur {
		display: flex;
		width: max-content;
		animation: ticker-lauf 30s linear infinite;
	}

	.ticker:hover .ticker-spur {
		animation-play-state: paused;
	}

	.ticker-spur :global(.ticker-eintrag) {
		padding: 0.6rem 2.5rem;
	}

	.ticker-spur :global(.ticker-eintrag)::before {
		content: '♪';
		margin-inline-end: 0.75rem;
		opacity: 0.6;
	}

	@keyframes ticker-lauf {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker-spur {
			animation: none;
		}
		.ticker {
			overflow-x: auto;
		}
	}

	.hero-logo {
		width: min(280px, 70vw);
		height: auto;
		filter: drop-shadow(0 2px 12px rgb(14 38 71 / 0.6));
	}

	.tagline {
		max-width: 34ch;
		margin: 1.5rem auto 0;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2vw + 0.5rem, 1.4rem);
		font-weight: 500;
		line-height: 1.4;
	}

	.inhalt {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 3rem);
	}

	.hoer-rein {
		margin-block-end: 0;
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 5vw, 3rem);
	}

	.hoer-rein-inhalt {
		max-width: 720px;
		margin: 0 auto;
	}

	.hoer-rein h2 {
		margin: 0 0 1rem;
	}

	.hoer-rein iframe {
		display: block;
		border-radius: 12px;
	}
</style>
