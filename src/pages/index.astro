---
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseAuftritte, splitByZeitpunkt, formatDatumZeit, type Auftritt } from '../lib/auftritte';

const csvUrl = process.env.AUFTRITTE_SHEET_CSV_URL;

let auftritte: Auftritt[] = [];
if (!csvUrl) {
	console.warn('AUFTRITTE_SHEET_CSV_URL ist nicht gesetzt – es werden keine Auftritte angezeigt.');
} else {
	try {
		const response = await fetch(csvUrl);
		if (!response.ok) {
			console.warn(`Auftritte-Sheet konnte nicht geladen werden (HTTP ${response.status}).`);
		} else {
			auftritte = parseAuftritte(await response.text());
		}
	} catch (error) {
		console.warn(`Auftritte-Sheet konnte nicht geladen werden: ${error}`);
	}
}

const { bevorstehende, vergangene } = splitByZeitpunkt(auftritte);

function tag(iso: string): string {
	return new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', timeZone: 'UTC' });
}

function monat(iso: string): string {
	return new Date(iso)
		.toLocaleDateString('de-DE', { month: 'short', timeZone: 'UTC' })
		.replace('.', '')
		.toUpperCase();
}
---

<BaseLayout title="Start">
	<section class="hero">
		<picture>
			<source media="(prefers-reduced-motion: reduce)" srcset="/logo/emscherspatzen-weiss.svg" />
			<img src="/logo/emscherspatzen-animiert-weiss.gif" alt="Emscherspatzen" class="hero-logo" />
		</picture>
		<p class="tagline">
			„Andere Städte haben auch einen Chor, aber so wie wir singt dir keiner was vor.“
		</p>
	</section>

	<div class="inhalt">
		<section>
			<h2>Bevorstehende Auftritte</h2>
			{
				bevorstehende.length === 0 ? (
					<p>Aktuell sind keine Auftritte geplant.</p>
				) : (
					<ul class="auftritte-liste">
						{bevorstehende.map((a) => (
							<li>
								<div class="datumsschild">
									<span class="tag">{tag(a.datum)}</span>
									<span class="monat">{monat(a.datum)}</span>
								</div>
								<div class="auftritt-info">
									<h3>{a.titel}</h3>
									<p class="meta">
										{formatDatumZeit(a)}
										{a.ort && <span> · {a.ort}</span>}
									</p>
									{a.beschreibung && <p class="beschreibung">{a.beschreibung}</p>}
								</div>
							</li>
						))}
					</ul>
				)
			}
		</section>

		<section>
			<h2>Vergangene Auftritte</h2>
			{
				vergangene.length === 0 ? (
					<p>Noch keine vergangenen Auftritte.</p>
				) : (
					<ul class="auftritte-liste vergangen">
						{vergangene.map((a) => (
							<li>
								<div class="datumsschild">
									<span class="tag">{tag(a.datum)}</span>
									<span class="monat">{monat(a.datum)}</span>
								</div>
								<div class="auftritt-info">
									<h3>{a.titel}</h3>
									<p class="meta">
										{formatDatumZeit(a)}
										{a.ort && <span> · {a.ort}</span>}
									</p>
								</div>
							</li>
						))}
					</ul>
				)
			}
		</section>
	</div>

	<section class="hoer-rein" slot="abschluss">
		<div class="hoer-rein-inhalt">
			<h2>Hör rein</h2>
			<iframe
				src="https://open.spotify.com/embed/artist/22At3yJ4NbkH4fBnh5EHvi?utm_source=generator"
				title="Emscherspatzen auf Spotify"
				width="100%"
				height="152"
				frameborder="0"
				allowfullscreen
				allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				loading="lazy"></iframe>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2.5rem, 8vw, 5rem) clamp(1rem, 5vw, 3rem);
		text-align: center;
	}

	.hero-logo {
		width: min(280px, 70vw);
		height: auto;
	}

	.tagline {
		max-width: 34ch;
		margin: 1.5rem auto 0;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2vw + 0.5rem, 1.4rem);
		font-weight: 500;
		line-height: 1.4;
	}

	.inhalt {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 3rem);
	}

	section {
		margin-block-end: 3rem;
	}

	.auftritte-liste {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.auftritte-liste li {
		display: flex;
		gap: 1.25rem;
		border: 1px solid var(--blau-hell);
		border-inline-start: 4px solid var(--blau);
		padding: 1rem 1.25rem;
		background: var(--weiss);
	}

	.auftritte-liste.vergangen li {
		border-inline-start-color: #b7bfc9;
		background: transparent;
	}

	.datumsschild {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		font-family: var(--font-display);
		line-height: 1;
	}

	.datumsschild .tag {
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--blau-dunkel);
	}

	.datumsschild .monat {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--blau);
		margin-block-start: 0.25rem;
	}

	.vergangen .datumsschild .tag,
	.vergangen .datumsschild .monat {
		color: #6b7280;
	}

	.auftritt-info {
		min-width: 0;
	}

	.auftritt-info h3 {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0;
	}

	.meta {
		margin: 0.2rem 0 0;
		font-size: 0.9375rem;
		color: #4b5563;
	}

	.beschreibung {
		margin: 0.5rem 0 0;
	}

	.hoer-rein {
		margin-block-end: 0;
		background: var(--blau-dunkel);
		color: var(--weiss);
		padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 5vw, 3rem);
	}

	.hoer-rein-inhalt {
		max-width: 720px;
		margin: 0 auto;
	}

	.hoer-rein h2 {
		margin: 0 0 1rem;
	}

	.hoer-rein iframe {
		display: block;
		border-radius: 12px;
	}
</style>
